generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

///////////////////////
// ENUMS
///////////////////////

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum MemberStatus {
  NONE         
  PENDING
  APPROVED
  REJECTED
}

enum MemberType {
  ELEVE
  ETUDIANT
  PROFESSIONNEL
  MEMBRE
}

enum PaymentMethod {
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  WAVE
  CASH
  BANK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentType {
  COTISATION
  COTISATION_TIERCE
  DON
  CARTE
  SERVICE
  EVENT
}

enum CardStatus {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

enum EventStatus {
  DRAFT        // en cours de création (visible "En cours")
  SCHEDULED    // programmé (date fixée)
  ACTIVE       // en cours maintenant
  COMPLETED    // passé
  CANCELLED    // désactivé / annulé
  POSTPONED    // reporté
}

///////////////////////
// USER
///////////////////////

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  firstName   String
  lastName    String?
  number      String   @unique
  email       String?
  photo       String?

  city        String?
  address     String?
  sex         String?

  role        Role     @default(MEMBER)
  profession  String?
  occupation  String?
  entreprise  String?

  // infos supplémentaires frontend
  etablissement String?
  niveau        String?
  filiere       String?
  matricule     String?

  document      String?

  section       String?
  birthDate     DateTime?

  // statut membre
  isMember      Boolean  @default(false)
  memberStatus  MemberStatus @default(PENDING)
  numeroMembre  String?
  memberType  MemberType?
  poste       String?
  certifie      Boolean  @default(false)

  // auth
  password      String?
  isVerify      Boolean  @default(false)
  havePass      Boolean  @default(false)

  // relations
  payments      Payment[]
  memberCard    MemberCard?
  // Cotisations dont je bénéficie
  memberCotisations CotisationRecord[] @relation("MemberCotisations")
  // Cotisations que j'ai payées
  paidCotisations CotisationRecord[] @relation("PaidCotisations")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

///////////////////////
// EXPENSE AEEY
///////////////////////

model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  name        String   // frontend "name"
  phoneNumber String   // frontend "number"

  description String
  amount      Int

  method      PaymentMethod

  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}

///////////////////////
// MEMBER CARD
///////////////////////

model MemberCard {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId

  userId       String      @db.ObjectId @unique
  user         User        @relation(fields: [userId], references: [id])

  // Snapshot identité
  nom          String?
  prenoms      String?
  photo        String?
  code         String?     @unique
  date         String?

  // Infos selon profil
  poste        String?
  memberType   MemberType?
  organisation String?
  classe       String?
  detail       String?
  matricule    String?

  // Infos de paiement associé
  payments      Payment[]

  status       CardStatus  @default(EN_ATTENTE)
  demandeDate  DateTime    @default(now())
  validatedAt  DateTime?

  // Date d'expiration de la carte
  expiresAt    DateTime?
}

model CardSetting {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    title String
    amount Int

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

///////////////////////
// PAYMENT
///////////////////////

model Payment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?       @db.ObjectId
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String?       // correspond à frontend "name"
  phoneNumber String        // correspond à "number"
  amount      Int
  type        PaymentType
  method      String?
  description String?
  status      PaymentStatus @default(PENDING)

  // Relation avec la carte
  memberCardId String?       @db.ObjectId
  memberCard   MemberCard?   @relation(fields: [memberCardId], references: [id])

  // Relation avec la cotisation  
  cotisationId String?       @db.ObjectId
  cotisation   Cotisation?   @relation(fields:[cotisationId], references:[id])
  cotisationRecord   CotisationRecord?

  // Relation avec l'evenement
  eventId String?            @db.ObjectId
  event   Event?             @relation(fields:[eventId], references:[id])

  // Relation avec le donation
  donationId String?         @db.ObjectId
  donation Donation?         @relation(fields:[donationId], references:[id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime?     @updatedAt
}

/////////////////////// 
// CAUTISATION AEEY
///////////////////////

model Cotisation {
  id          String @id @default(auto()) @map("_id") @db.ObjectId

  title       String
  amount      Int
  description String?
  period      String

  active      Boolean @default(true)

  payments    Payment[]
  records     CotisationRecord[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CotisationRecord {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  // Paiement associé
  paymentId String   @unique @db.ObjectId
  payment   Payment  @relation(fields: [paymentId], references: [id])

  // Cotisation concernée (Mensuelle, Annuelle, etc.)
  cotisationId String      @db.ObjectId
  cotisation   Cotisation  @relation(fields: [cotisationId], references: [id])

  // Membre bénéficiaire
  memberId String @db.ObjectId
  member   User   @relation("MemberCotisations", fields: [memberId], references: [id])

  // Celui qui a payé (peut être null si invité)
  payerId String? @db.ObjectId
  payer   User?   @relation("PaidCotisations", fields: [payerId], references: [id])

  createdAt DateTime @default(now())
}

/////////////////////// 
// DONATION AEEY
///////////////////////

model Donation {
  id            String @id @default(auto()) @map("_id") @db.ObjectId

  title         String
  description   String?

  targetAmount  Int?
  minimumAmount Int?

  status        Boolean @default(false)
  isActive      Boolean @default(true)

  payments      Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/////////////////////// 
// EVENEMENT AEEY
///////////////////////

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  title       String
  description String?

  location    String?
  date        DateTime?

  image       String?

  status      EventStatus @default(DRAFT) // par défaut "en cours"

  amount      Int?

  // Somme réellement encaissée
  collectedAmount Int @default(0)
  // Nombre de paiements réussis
  participantCount Int @default(0)
  payments    Payment[]

  // utile pour reprogrammation
  previousDate DateTime?
  rescheduledAt DateTime?

  isPublished Boolean @default(false) // visible au public ou pas

  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}